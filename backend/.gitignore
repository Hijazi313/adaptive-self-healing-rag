.ipynb_checkpoints/
*.ipynb

# ── Docker ────────────────────────────────────────────────────────────────────
# Data volumes are managed by Docker, not git.
qdrant_data/
redis_data/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store


# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
 
# ── Model artifacts (if any local models downloaded) ─────────────────────────
models/
*.bin
*.safetensors


# ── Secrets — NEVER commit these ──────────────────────────────────────────────
.env
*.pem
*.key